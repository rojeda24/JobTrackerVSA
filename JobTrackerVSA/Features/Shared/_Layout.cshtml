<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_LayoutCssPartial" />
</head>
<body>
    @if (User.HasClaim(c => c.Type == "is_demo"))
    {
        <div class="alert alert-danger text-center m-0 rounded-0 p-1">
            <small><strong>PUBLIC DEMO MODE:</strong> Data is shared. Changes reset daily at 3am (MST). Do not enter sensitive info. The website owner assumes no responsibility for the content.</small>
        </div>
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" href="/">Job Tracker</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/ExportCoverLetters">Export Cover Letters</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <partial name="_Notification" />

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Raúl Ojeda - <a asp-area="" asp-page="/Privacy">Privacy policy & terms</a>
        </div>
    </footer>

    <partial name="_LayoutScriptsPartial" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
