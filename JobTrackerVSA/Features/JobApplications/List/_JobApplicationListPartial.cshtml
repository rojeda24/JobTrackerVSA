@using JobTrackerVSA.Web.Infrastructure.Shared
@using JobTrackerVSA.Web.Features.JobApplications.List
@model PagedList<JobApplicationSummaryViewModel>

<style>
    .job-card-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .job-card-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>

<div class="d-flex flex-column gap-3 mb-4">
    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5 text-muted">
            <div class="card-body">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-3 mb-0">No job applications found. Click "Add Job Application" to get started!</p>
            </div>
        </div>
    }
    @foreach (var app in Model.Items)
    {
        <div class="card border-0 shadow-sm position-relative job-card-hover">
            <div class="card-body">
                <div class="row align-items-center gy-3">
                    
                    <!-- Date -->
                    <div class="col-12 col-md-2">
                        <div class="text-muted small mb-1">Next Interview</div>
                        @if (app.NextInterviewAt.HasValue)
                        {
                            <span class="local-date fw-bold text-primary" 
                                  data-utc="@app.NextInterviewAt.Value.ToString("yyyy-MM-ddTHH:mm:ssZ")" 
                                  data-format="default">
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">---</span>
                        }
                    </div>
                    
                    <!-- Company, Position & Status -->
                    <div class="col-12 col-md-3">
                        <div class="fw-bold fs-5 mb-1">
                            <a href="/edit/@app.Id" class="text-decoration-none text-dark stretched-link">
                                @app.CompanyName
                            </a>
                        </div>
                        <div class="position-relative z-3 mb-2">
                            @if (!string.IsNullOrWhiteSpace(app.JobDescriptionUrl))
                            {
                                <a href="@app.FinalJobUrl" target="_blank" class="fw-medium text-primary text-decoration-underline">
                                    @app.Position <i class="bi bi-box-arrow-up-right ms-1 small"></i>
                                </a>
                            }
                            else
                            {
                                <span class="fw-medium text-secondary">@app.Position</span>
                            }
                        </div>
                        <span class="badge @(app.Status == JobTrackerVSA.Web.Domain.JobApplication.ApplicationStatus.Rejected ? "bg-danger" : "bg-success")">
                            @app.StatusDisplay
                        </span>
                    </div>

                    <!-- Notes -->
                    <div class="col-12 col-md-5">
                        <div class="text-muted small mb-1">Notes</div>
                        <div title="@app.Notes" class="text-truncate text-muted small">
                            @app.Notes
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="col-12 col-md-2 text-md-end">
                        <div class="d-flex flex-column gap-2 align-items-stretch align-items-md-end position-relative z-3">
                            @if (!string.IsNullOrEmpty(app.ResumeUrl))
                            {
                                <a href="@app.ResumeUrl" target="_blank" class="btn btn-sm btn-outline-primary text-nowrap w-100" title="View Resume">
                                    <i class="bi bi-file-earmark-text"></i> <span>Resume</span>
                                </a>
                            }
                            <form method="post" asp-page-handler="Delete" asp-route-id="@app.Id" class="w-100"
                                  onsubmit="return confirm('Are you sure you want to delete this application and all its interviews?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger text-nowrap w-100" title="Delete">
                                    <i class="bi bi-trash"></i> <span>Delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Job applications pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" href="?PageNumber=@(Model.Page - 1)" data-page="@(Model.Page - 1)">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="?PageNumber=@i" data-page="@i">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" href="?PageNumber=@(Model.Page + 1)" data-page="@(Model.Page + 1)">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
